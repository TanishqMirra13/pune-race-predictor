# Copy to .env and fill in. .env is gitignored; .env.example is not, so never
# put a real key in this file.
#
# NEVER paste an API key into a chat window, an issue, or a source file. The
# only place it belongs is .env on your own machine.
#
# These configure the generic odds adapter in scrapers/odds_import.py. It is
# deliberately book-agnostic -- you describe whatever endpoint you have access
# to rather than the code hard-coding one provider's schema, since those change
# without notice.

# Endpoint. "{race}" is substituted with the race reference you type in the UI.
ODDS_API_URL=https://example.com/api/races/{race}/odds

# Your key.
ODDS_API_TOKEN=

# Header to send the key in.
ODDS_API_TOKEN_HEADER=x-access-token

# Dotted path from the JSON root to the array of runners, e.g. data.race.runners
ODDS_API_RUNNER_PATH=data.race.runners

# Field names on each runner object.
ODDS_API_NAME_FIELD=name
ODDS_API_WIN_FIELD=winOdds
ODDS_API_PLACE_FIELD=placeOdds


# ---------------------------------------------------------------------------
# BET PLACEMENT (scrapers/bookmaker.py) -- separate from the odds variables
# above, because reading prices and moving money are different permissions.
#
# Placement is OFF unless all of these are set AND the calling code passes
# allow_real_bets=True. Two switches, one in the environment and one in code,
# so neither a stray default nor a copied .env can start betting on its own.
#
# Note on Stake specifically: both stake.com and the stake1021.com mirror
# return Cloudflare's bot challenge to every programmatic request, so an
# automated bet will fail there regardless of what you put below. The adapter
# detects that and says so rather than retrying. Place manually from the bet
# slip instead -- it prints a minimum acceptable price for exactly that.
# ---------------------------------------------------------------------------

# Endpoint that accepts a bet.
BET_API_URL=

# Your session or API token. NEVER commit this, never paste it into a chat.
BET_API_TOKEN=

# Header to send the token in.
BET_API_TOKEN_HEADER=x-access-token

# Must be exactly "true" before any real bet is placed.
BET_API_ENABLED=false
