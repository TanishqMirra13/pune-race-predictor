# Python
venv/
__pycache__/
*.pyc
*.pyo

# Scraper HTML cache -- large (~68MB) and fully regenerable from the live sites,
# so it does NOT ship in the repo. The SQLite DB below already holds the parsed
# data, and the app re-fetches fresh pages on demand.
data/cache/

# Ignore everything else in data/ (loose dev sample HTML/PDF/JSON, ~4.5MB) --
# EXCEPT the seed database, which we want to ship so the deployed app has all
# the backfilled races/workouts/calibration on first boot.
data/*
!data/pune_racing.db

# Dev scratch specs not part of the app
docs/

# Secrets -- never commit. .env holds the bookmaker/odds API credentials that
# scrapers/odds_import.py reads; committing it would push a live betting-account
# key to the remote. On Streamlit Cloud these go in the app's Secrets panel.
.env
.env.*
!.env.example
.streamlit/secrets.toml

# OS junk
.DS_Store
Thumbs.db
